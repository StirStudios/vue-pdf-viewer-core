{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(npm run lint:*)",
      "Bash(npm run typecheck:*)",
      "Bash(npm test:*)",
      "Bash(npm run test:*)",
      "Bash(npm run build:*)",
      "Bash(npm run format:*)",
      "Bash(npm run smoke:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git branch:*)"
    ],
    "deny": [
      "Bash(npm run release:*)",
      "Bash(npm run publish:check:*)",
      "Bash(npm run prepublishOnly:*)",
      "Read(./.env)",
      "Read(./.env.*)"
    ]
  }
}
